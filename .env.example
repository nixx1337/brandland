# Environment template for .env file
# Copy to .env and fill in your values

# Your domain name (used by Caddy/nginx)
DOMAIN=brandland.com.ua

# Port to expose (use 80 if Caddy handles 443, or 8080 for direct)
PORT=8080

# Optional: Cloudflare Tunnel token (if using Cloudflare Tunnel instead of direct port)
# CLOUDFLARE_TUNNEL_TOKEN=your-token-here
